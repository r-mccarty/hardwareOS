{
  "name": "opticworks-cloud-api",
  "version": "1.0.0",
  "description": "OpticWorks Cloud API - Device management, authentication, OTA updates, and telemetry",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "db:init": "wrangler d1 execute opticworks-devices --local --file=./src/db/schema.sql",
    "db:init:remote": "wrangler d1 execute opticworks-devices --remote --file=./src/db/schema.sql",
    "db:create": "wrangler d1 create opticworks-devices",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail"
  },
  "keywords": ["cloudflare", "workers", "api", "opticworks", "iot"],
  "author": "OpticWorks",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.11.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251221.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.56.0"
  }
}
